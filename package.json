{
  "name": "@qiejianchuangyi/dsh-skill-menu",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Skill menu in the composer: lists installed skills, shows a Chinese note on hover, and invokes one into the conversation.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "skills",
    "screenshots",
    "tests",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiejianchuangyi/dsh-skill-menu.git"
  },
  "homepage": "https://github.com/qiejianchuangyi/dsh-skill-menu#readme",
  "bugs": {
    "url": "https://github.com/qiejianchuangyi/dsh-skill-menu/issues"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skills",
    "composer",
    "bundle"
  ]
}
